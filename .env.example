# IoT Flutter Web Client — public configuration template
# Copy to .env and replace the anon key with the deployment's public anon key.
# This file is not automatically loaded by the current application.
# All configuration bundled into Flutter Web is publicly readable.
# Never add service-role keys, JWT secrets, database/MQTT passwords or private keys.

# Go REST API through Nginx. Keep /v1/ and join relative paths such as gateways.
BACKEND_API_BASE_URL=http://localhost/v1/

# Supabase API Gateway root; do not append /auth/v1 or /v1.
SUPABASE_URL=http://localhost

# Public client key only. This placeholder is not a usable credential.
SUPABASE_ANON_KEY=replace_with_public_anon_key

# Allowed values: development, staging, production.
ENVIRONMENT=development

# Optional future realtime endpoint. Currently a 501 stub; do not connect yet.
BACKEND_WS_URL=ws://localhost/v1/ws

# Production: use HTTPS URLs and WSS for future realtime connections.
# Web dev across origins requires configured CORS or a controlled same-origin proxy.
# Do not use Android emulator address 10.0.2.2 for this web client.
